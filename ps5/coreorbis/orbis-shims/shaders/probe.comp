// Mupen64Plus PS5: the Vulkan self-test's compute shader (ProsperoVulkan.cpp): v[i] = i * 2654435761 + seed.
// SPDX-License-Identifier: MIT
#version 450
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Data { uint v[]; };
layout(push_constant) uniform Push { uint seed; };

void main()
{
	uint i = gl_GlobalInvocationID.x;
	v[i] = i * 2654435761u + seed;
}
